/**
 * CashewCare — automação do formulário do site
 *
 * O que faz, a cada envio do formulário:
 *   1. Salva o contato na planilha "Leads CashewCare" (aba "Leads").
 *   2. Envia para a pessoa um e-mail de boas-vindas, com a logo e o Instagram,
 *      a partir da conta cashewcarecontato@gmail.com.
 *   3. Avisa a equipe (cashewcarecontato@gmail.com) que chegou um novo contato.
 *
 * Este script deve ser criado e publicado LOGADO na conta cashewcarecontato@gmail.com
 * (é essa conta que aparece como remetente). Passo a passo em LEIA-ME.md.
 */

const CONFIG = {
  TEAM_EMAIL: 'cashewcarecontato@gmail.com',
  SENDER_NAME: 'CashewCare',
  INSTAGRAM_URL: 'https://www.instagram.com/cashewcareoficial/',
  INSTAGRAM_HANDLE: '@cashewcareoficial',
  SHEET_NAME: 'Leads',
  NOTIFY_TEAM: true,
};

const LOGO_B64 = '';
const IG_B64 = '';

function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.tryLock(10000);
  try {
    const p = (e && e.parameter) || {};
    if (p.site) return json_({ ok: true }); // honeypot (bot)

    const nome = clean_(p.nome, 120);
    const email = clean_(p.email, 160).toLowerCase();
    const whatsapp = clean_(p.whatsapp, 40);
    const perfil = clean_(p.perfil, 40);

    if (!nome || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      return json_({ ok: false, error: 'dados inválidos' });
    }

    sheet_().appendRow([new Date(), nome, email, whatsapp, perfil, 'site']);

    sendWelcome_(nome, email, perfil);
    if (CONFIG.NOTIFY_TEAM) notifyTeam_(nome, email, whatsapp, perfil);

    return json_({ ok: true });
  } catch (err) {
    console.error(err);
    return json_({ ok: false, error: String(err) });
  } finally {
    lock.releaseLock();
  }
}

function doGet() {
  return ContentService.createTextOutput('CashewCare — formulário ativo.');
}

function sendWelcome_(nome, email, perfil) {
  const primeiroNome = nome.split(' ')[0];
  const logo = Utilities.newBlob(Utilities.base64Decode(LOGO_B64), 'image/png', 'cashewcare-logo.png');
  const ig = Utilities.newBlob(Utilities.base64Decode(IG_B64), 'image/png', 'instagram.png');

  const html = `
  <div style="background:#FFFCF9;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;color:#171717;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:20px;border:1px solid #eee;">
      <tr><td align="center" style="padding:32px 32px 8px;">
        <img src="cid:logo" width="160" alt="CashewCare" style="display:block;border:0;width:160px;height:auto;">
      </td></tr>
      <tr><td style="padding:16px 32px 8px;font-size:16px;line-height:1.6;">
        <p style="margin:0 0 14px;">Olá, <strong>${esc_(primeiroNome)}</strong>! 🌱</p>
        <p style="margin:0 0 14px;">Recebemos o seu contato e ficamos muito felizes com o seu interesse no <strong>CashewCare</strong> — o app que diagnostica pragas e doenças do cajueiro a partir de uma foto.</p>
        <p style="margin:0 0 14px;">Fique à vontade para nos mandar qualquer pergunta: é só <strong>responder este e-mail</strong>. Nossa equipe retorna em até 48h.</p>
        <p style="margin:0 0 6px;">Enquanto isso, acompanhe as novidades e os bastidores do projeto no nosso Instagram:</p>
      </td></tr>
      <tr><td align="center" style="padding:12px 32px 28px;">
        <a href="${CONFIG.INSTAGRAM_URL}" target="_blank" style="display:inline-block;text-decoration:none;color:#171717;font-weight:700;font-size:15px;border:1px solid #eee;border-radius:999px;padding:10px 18px;">
          <img src="cid:ig" width="24" height="24" alt="Instagram" style="vertical-align:middle;border:0;margin-right:8px;">
          <span style="vertical-align:middle;">${CONFIG.INSTAGRAM_HANDLE}</span>
        </a>
      </td></tr>
      <tr><td style="padding:18px 32px;border-top:1px solid #f0f0f0;font-size:12px;line-height:1.5;color:#777;" align="center">
        CashewCare · IFCE — Campus Fortaleza<br>
        3º lugar na América Latina · Huawei Developer Competition 2025<br>
        <a href="mailto:${CONFIG.TEAM_EMAIL}" style="color:#006F47;">${CONFIG.TEAM_EMAIL}</a>
      </td></tr>
    </table>
  </div>`;

  const text =
    `Olá, ${primeiroNome}!\n\n` +
    `Recebemos o seu contato e ficamos muito felizes com o seu interesse no CashewCare.\n` +
    `Fique à vontade para nos mandar qualquer pergunta: é só responder este e-mail.\n\n` +
    `Instagram: ${CONFIG.INSTAGRAM_URL}\n\nEquipe CashewCare`;

  MailApp.sendEmail({
    to: email,
    subject: `Bem-vindo(a) ao CashewCare, ${primeiroNome}! 🌱`,
    body: text,
    htmlBody: html,
    name: CONFIG.SENDER_NAME,
    replyTo: CONFIG.TEAM_EMAIL,
    inlineImages: { logo: logo, ig: ig },
  });
}

function notifyTeam_(nome, email, whatsapp, perfil) {
  MailApp.sendEmail({
    to: CONFIG.TEAM_EMAIL,
    subject: `Novo contato pelo site: ${nome} (${perfil || 'sem perfil'})`,
    body: `Nome: ${nome}\nE-mail: ${email}\nWhatsApp: ${whatsapp}\nPerfil: ${perfil}\n\nPlanilha: ${sheet_().getParent().getUrl()}`,
    name: 'Site CashewCare',
    replyTo: email,
  });
}

function sheet_() {
  const props = PropertiesService.getScriptProperties();
  let id = props.getProperty('SHEET_ID');
  let ss;
  if (id) {
    ss = SpreadsheetApp.openById(id);
  } else {
    ss = SpreadsheetApp.create('Leads CashewCare');
    props.setProperty('SHEET_ID', ss.getId());
  }
  let sh = ss.getSheetByName(CONFIG.SHEET_NAME);
  if (!sh) {
    sh = ss.getSheets()[0];
    sh.setName(CONFIG.SHEET_NAME);
    sh.appendRow(['Data', 'Nome', 'E-mail', 'WhatsApp', 'Perfil', 'Origem']);
    sh.setFrozenRows(1);
    sh.getRange('A1:F1').setFontWeight('bold');
  }
  return sh;
}

function clean_(v, max) {
  return String(v || '').trim().replace(/[\r\n\t]+/g, ' ').slice(0, max);
}
function esc_(s) {
  return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

